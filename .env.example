# Server Configuration
PORT=3000
NODE_ENV=development

# Database
MONGO_URI=mongodb://127.0.0.1:27017/student-marketplace

# JWT Configuration
JWT_SECRET=your-secret-key-change-in-production

# Email Configuration (Gmail with App Password)
# 1. Enable 2-Step Verification: https://myaccount.google.com/security
# 2. Generate App Password: Security > App passwords
# 3. Select "Mail" and "Other (Custom name)"
# 4. Copy the 16-character password (remove spaces)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-16-char-app-password

# Frontend URL (for email verification links)
# Development: Point to your frontend dev server (Vite: 5173, CRA: 3001)
# Production: Point to your deployed frontend domain
FRONTEND_URL=http://localhost:5173

# Backend URL (optional - for reference)
BACKEND_URL=http://localhost:3000

# Cloudinary Configuration (for image uploads)
# Sign up at: https://cloudinary.com/
# Get credentials from: https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
